   "source": [
    "mean_error, std_error = closure_statistics(errors)\n",
    "\n",
    "plot(\n",
    "    1:length(mean_error),\n",
    "    mean_error .* 1e6,           # km → mm\n",
    "    ribbon = std_error .* 1e6,\n",
    "    xlabel = \"Repeat Cycle\",\n",
    "    ylabel = \"Closure Error (mm)\",\n",
    "    title = \"Analytical J₂ Repeat Orbit Closure\",\n",
    "    lw = 2,\n",
    "    marker = :circle,\n",
    "    label = \"Mean ± Std\"\n",
    ")"
   ]
  },
