   "source": [
    "using Plots\n",
    "\n",
    "cycles = 1:length(mean_error)\n",
    "\n",
    "p = plot(\n",
    "    cycles,\n",
    "    mean_error .* 1e6,          # km → mm\n",
    "    ribbon = std_error .* 1e6,  # ±1σ\n",
    "    lw = 2.5,\n",
    "    color = :blue,\n",
    "    fillalpha = 0.25,\n",
    "    marker = :circle,\n",
    "    ms = 3,\n",
    "    xlabel = \"Repeat Cycle\",\n",
    "    ylabel = \"Mean Closure Error (mm)\",\n",
    "    title = \"Repeat Orbit Closure Validation (100 Cycles)\",\n",
    "    label = \"Mean ± 1σ\",\n",
    "    legend = :topright,\n",
    "    grid = true\n",
    ")\n",
    "\n",
    "\n",
    "savefig(p, \"/home/Arpan/orbit/Figures/closure_error.png\")"
   ]
