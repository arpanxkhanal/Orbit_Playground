    "# ============================================================\n",
    "# Test Refactored J2 Propagator\n",
    "# ============================================================\n",
    "\n",
    "result_old = propagate_j2_old(\n",
    "    sat,\n",
    "    GM,\n",
    "    ωE;\n",
    "    dt = 30.0,\n",
    "    revolutions = 5\n",
    ")\n",
    "\n",
    "result_new = propagate_j2(\n",
    "    sat,\n",
    "    GM,\n",
    "    ωE;\n",
    "    dt = 30.0,\n",
    "    revolutions = 5\n",
    ")\n",
    "\n",
    "println()\n",
    "println(\"========================================\")\n",
    "println(\"      REFACTOR VALIDATION TEST\")\n",
    "println(\"========================================\")\n",
    "\n",
