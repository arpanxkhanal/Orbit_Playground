    "    maximum(abs.(result_old.positions_eci .- result_new.positions_eci)))\n",
    "\n",
    "println(\"Maximum ECEF Position Error     : \",\n",
    "    maximum(abs.(result_old.positions_ecef .- result_new.positions_ecef)))\n",
    "\n",
    "println(\"Maximum ECI Velocity Error      : \",\n",
    "    maximum(abs.(result_old.velocities_eci .- result_new.velocities_eci)))\n",
    "\n",
    "println(\"Maximum Latitude Error          : \",\n",
    "    maximum(abs.(result_old.latitudes .- result_new.latitudes)))\n",
    "\n",
    "println(\"Maximum Longitude Error         : \",\n",
    "    maximum(abs.(result_old.longitudes .- result_new.longitudes)))\n",
    "\n",
    "println()\n",
    "\n",
    "println(\"Maximum Semi-major Axis Error   : \",\n",
